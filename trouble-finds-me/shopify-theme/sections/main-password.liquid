<section class="hero" style="min-height:100%"><div class="grain"></div><div class="wrap">
  <div>
    <div class="eyebrow">{{ section.settings.eyebrow }}</div>
    <h1><span>{{ shop.name }}</span></h1>
    <p class="lede">{{ section.settings.text }}</p>
    {% render 'waitlist-form', form_id: 'waitlist-password', button: 'Join the waitlist' %}
    <details style="margin-top:24px"><summary>Store password</summary><div>
      {%- form 'storefront_password', class: 'signup' -%}
        {%- if form.errors %}<p class="form-msg err">{{ form.errors | default_errors }}</p>{% endif -%}
        <div class="field"><label for="pw">Password</label><input id="pw" type="password" name="password" autocomplete="current-password"></div>
        <button class="btn ghost" type="submit">Enter</button>
      {%- endform -%}
    </div></details>
  </div>
  <div class="art"><img src="{{ 'rtt-orange-back.jpg' | asset_url }}" alt="Ride the Tiger concept artwork" width="768" height="1024"><p class="caption">Concept artwork. Not a photo of the finished shirt.</p></div>
</div></section>
{% schema %}
{ "name": "Password page", "settings": [
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drop 001 · Coming soon" },
  { "type": "textarea", "id": "text", "label": "Text", "default": "Heavyweight pump covers with old-school iron graphics. Waitlist gets first access to Ride the Tiger." } ] }
{% endschema %}
