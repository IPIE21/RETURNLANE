<div class="page-head"><div class="wrap"><h1>{{ blog.title }}</h1></div></div>
<section class="block"><div class="wrap"><div class="grid">
{%- for article in blog.articles -%}<a class="card" href="{{ article.url }}"><div class="meta" style="padding-top:16px"><span class="eyebrow">{{ article.published_at | date: '%b %d, %Y' }}</span><h3>{{ article.title }}</h3></div></a>{%- endfor -%}
</div></div></section>
{% schema %}{ "name": "Blog" }{% endschema %}
