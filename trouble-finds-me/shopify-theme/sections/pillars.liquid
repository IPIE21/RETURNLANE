<section class="block"><div class="wrap">
  <div class="eyebrow">{{ section.settings.eyebrow }}</div>
  <h2>{{ section.settings.heading }}</h2>
  <div class="pillars">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
    {%- endfor -%}
  </div>
</div></section>
{% schema %}
{
  "name": "Pillars",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What we make" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built like the old gyms" }
  ],
  "blocks": [ { "type": "pillar", "name": "Pillar", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Heavyweight" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Thick cotton that holds its shape." } ] } ],
  "max_blocks": 3,
  "presets": [ { "name": "Pillars", "blocks": [ { "type": "pillar" }, { "type": "pillar" }, { "type": "pillar" } ] } ]
}
{% endschema %}
